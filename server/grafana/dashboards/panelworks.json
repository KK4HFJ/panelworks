{
  "uid": "panelworks",
  "title": "PanelWorks panels",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "panelworks"
  ],
  "description": "Pick a panel (measurement); one graph per field. Logged by PanelWorks InfluxDB controls.",
  "templating": {
    "list": [
      {
        "name": "measurement",
        "label": "Measurement",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-panelworks"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.measurements(bucket: v.defaultBucket)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.measurements(bucket: v.defaultBucket)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "field",
        "label": "Field",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-panelworks"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.measurementFieldKeys(bucket: v.defaultBucket, measurement: \"${measurement}\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.measurementFieldKeys(bucket: v.defaultBucket, measurement: \"${measurement}\")",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "${measurement}: ${field}",
      "repeat": "field",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-panelworks"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-panelworks"
          },
          "query": "import \"types\"\nfrom(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${measurement}\" and r._field == \"${field}\")\n  |> filter(fn: (r) => types.isType(v: r._value, type: \"float\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "${measurement}: latest values (all fields)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-panelworks"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-panelworks"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"${measurement}\")\n  |> last()\n  |> keep(columns: [\"_field\", \"_value\", \"_time\"])\n  |> group()"
        }
      ]
    }
  ]
}