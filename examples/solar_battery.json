{
  "name": "SolarBattery",
  "caption": "Off-grid power - Victron GX",
  "width": 760,
  "height": 640,
  "code": "solar_battery.py",
  "objects": {
    "lblTitle":  {"type": "Label", "Caption": "Off-grid power", "FontSize": 15, "FontBold": true, "Left": 15, "Top": 10, "Width": 260, "Height": 28},
    "shpLink":   {"type": "Shape", "FillColor": "gray", "Left": 420, "Top": 14, "Width": 18, "Height": 18},
    "lblLink":   {"type": "Label", "Caption": "Connecting...", "Left": 444, "Top": 14, "Width": 300, "Height": 20},
    "gauSOC":    {"type": "Gauge", "Title": "Battery", "Units": "%", "Min": 0, "Max": 100, "Decimals": 0,
                  "Zones": ["0 15 red", "15 30 gold"], "Left": 15, "Top": 50, "Width": 235, "Height": 200},
    "gauPV":     {"type": "Gauge", "Title": "Solar", "Units": "W", "Min": 0, "Max": 3500, "Decimals": 0,
                  "Left": 262, "Top": 50, "Width": 235, "Height": 200},
    "gauBatt":   {"type": "Gauge", "Title": "Battery power (+ charging)", "Units": "W", "Min": -3000, "Max": 3000, "Decimals": 0,
                  "Zones": ["-3000 -2000 gold"], "Left": 509, "Top": 50, "Width": 235, "Height": 200},
    "lblVolts":  {"type": "Label", "Caption": "Battery --", "FontBold": true, "Left": 15, "Top": 262, "Width": 360, "Height": 22},
    "lblTTG":    {"type": "Label", "Caption": "Time to go --", "Left": 15, "Top": 288, "Width": 360, "Height": 22},
    "lblLoads":  {"type": "Label", "Caption": "Loads --", "Left": 385, "Top": 262, "Width": 360, "Height": 22},
    "lblGen":    {"type": "Label", "Caption": "Generator --", "Left": 385, "Top": 288, "Width": 200, "Height": 22},
    "chkGen":    {"type": "CheckBox", "Caption": "Run generator (relay 1)", "Left": 555, "Top": 286, "Width": 195, "Height": 24},
    "chtPower":  {"type": "Chart", "Title": "Power", "Units": "W", "Window": 180, "AutoScale": false, "Decimals": 0,
                  "YMin": -3000, "YMax": 3500, "Series": ["Solar", "Loads", "Battery"],
                  "Colors": ["#f9a825", "#1f77b4", "#2ca02c"],
                  "Left": 15, "Top": 320, "Width": 730, "Height": 170},
    "pnlAlarms": {"type": "AlarmPanel", "Title": "Alarms", "Left": 15, "Top": 500, "Width": 730, "Height": 125},
    "gx":        {"type": "Modbus", "Mode": "TCP", "Host": "${GX_HOST:-127.0.0.1}", "Port": "${GX_PORT:-5021}", "UnitID": 100,
                  "PollInterval": 1000,
                  "Poll": ["volts = hr 840 *0.1", "amps = hr 841 i16 *0.1", "batt_w = hr 842 i16", "soc = hr 843",
                           "state = hr 844", "ttg_h = hr 846 *100 /3600", "pv_w = hr 850", "ac_w = hr 817",
                           "dc_w = hr 860 i16", "gen_w = hr 823 i16", "relay1 = hr 806"],
                  "Fill": ["soc -> gauSOC.Value", "pv_w -> gauPV.Value", "batt_w -> gauBatt.Value",
                           "pv_w -> chtPower.Value", "ac_w -> chtPower.Value2", "batt_w -> chtPower.Value3"]},
    "alm":       {"type": "Alarms", "Interval": 1000,
                  "Rules": ["NoGX: gx.Connected == False delay=5 priority=1 message=GX device not answering",
                            "BattCritical: gx.soc < 15 deadband=3 priority=1 message=Battery critical: start the generator",
                            "BattLow: gx.soc < 30 deadband=3 priority=2 message=Battery low",
                            "LowVolts: gx.volts < 47 delay=5 priority=1 message=Battery voltage low",
                            "HeavyLoad: gx.ac_w > 2500 delay=5 priority=2 message=Heavy AC load",
                            "GenRunning: gx.gen_w > 0 priority=3 message=Generator running"]}
  }
}
