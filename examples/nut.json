{
  "name": "UpsNut",
  "caption": "UPS on NUT",
  "width": 650,
  "height": 340,
  "code": "nut.py",
  "objects": {
    "lblTitle": {
      "type": "Label",
      "Caption": "The UPS behind the Pi",
      "FontSize": 15,
      "FontBold": true,
      "Left": 15,
      "Top": 10,
      "Width": 300,
      "Height": 28
    },
    "shpLink": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 330,
      "Top": 14,
      "Width": 18,
      "Height": 18
    },
    "lblLink": {
      "type": "Label",
      "Caption": "Connecting...",
      "Left": 354,
      "Top": 14,
      "Width": 290,
      "Height": 20
    },
    "gauCharge": {
      "type": "Gauge",
      "Title": "Battery charge",
      "Units": "%",
      "Min": 0,
      "Max": 100,
      "Zones": [
        "0 25 red",
        "25 50 gold"
      ],
      "Left": 15,
      "Top": 50,
      "Width": 190,
      "Height": 180
    },
    "gauRuntime": {
      "type": "Gauge",
      "Title": "Runtime left",
      "Units": "min",
      "Min": 0,
      "Max": 180,
      "Zones": [
        "0 5 red",
        "5 10 gold"
      ],
      "Left": 215,
      "Top": 50,
      "Width": 190,
      "Height": 180
    },
    "shpMains": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 420,
      "Top": 55,
      "Width": 22,
      "Height": 22
    },
    "lblMains": {
      "type": "Label",
      "Caption": "Power --",
      "FontBold": true,
      "Left": 450,
      "Top": 56,
      "Width": 215,
      "Height": 22
    },
    "lblStatus": {
      "type": "Label",
      "Caption": "",
      "Left": 420,
      "Top": 84,
      "Width": 215,
      "Height": 40
    },
    "lblVolts": {
      "type": "Label",
      "Caption": "Input --",
      "Left": 420,
      "Top": 128,
      "Width": 215,
      "Height": 20
    },
    "lblLoad": {
      "type": "Label",
      "Caption": "Load --",
      "Left": 420,
      "Top": 150,
      "Width": 215,
      "Height": 20
    },
    "lblModel": {
      "type": "Label",
      "Caption": "",
      "Left": 420,
      "Top": 172,
      "Width": 215,
      "Height": 40
    },
    "cmdVars": {
      "type": "CommandButton",
      "Caption": "What does it report?",
      "Left": 15,
      "Top": 240,
      "Width": 170,
      "Height": 28
    },
    "lstVars": {
      "type": "ListBox",
      "Left": 195,
      "Top": 240,
      "Width": 440,
      "Height": 90
    },
    "nut1": {
      "type": "NUT",
      "Host": "${NUT_HOST:-127.0.0.1}",
      "Port": "${NUT_PORT:-13493}",
      "UPS": "${NUT_UPS:-pi-ups}",
      "PollInterval": 2000,
      "Poll": [
        "charge = battery.charge",
        "runtime = battery.runtime /60",
        "status = ups.status",
        "volts = input.voltage",
        "load = ups.load",
        "model = ups.model"
      ],
      "Fill": [
        "charge -> gauCharge.Value",
        "runtime -> gauRuntime.Value"
      ]
    }
  }
}
