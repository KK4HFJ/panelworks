    "lblBattery": {"type": "Label", "Caption": "Battery --", "Left": 420, "Top": 108, "Width": 230, "Height": 20},
    "lblUptime":  {"type": "Label", "Caption": "Up --", "Left": 420, "Top": 130, "Width": 230, "Height": 20},
    "fraPorts":   {"type": "Frame", "Caption": "Switch ports", "Left": 420, "Top": 156, "Width": 225, "Height": 100},
    "shpPort1":   {"type": "Shape", "FillColor": "gray", "Left": 432, "Top": 178, "Width": 16, "Height": 16},
    "lblPort1":   {"type": "Label", "Caption": "port 1", "Left": 454, "Top": 176, "Width": 180, "Height": 20},
    "shpPort2":   {"type": "Shape", "FillColor": "gray", "Left": 432, "Top": 202, "Width": 16, "Height": 16},
    "lblPort2":   {"type": "Label", "Caption": "port 2", "Left": 454, "Top": 200, "Width": 180, "Height": 20},
    "shpPort3":   {"type": "Shape", "FillColor": "gray", "Left": 432, "Top": 226, "Width": 16, "Height": 16},
