    "gauLoad":    {"type": "Gauge", "Title": "UPS load", "Units": "%", "Min": 0, "Max": 100,
                   "Zones": ["80 90 gold", "90 100 red"], "Left": 215, "Top": 50, "Width": 190, "Height": 180},
    "shpSource":  {"type": "Shape", "FillColor": "gray", "Left": 420, "Top": 55, "Width": 22, "Height": 22},
    "lblSource":  {"type": "Label", "Caption": "Power --", "FontBold": true, "Left": 450, "Top": 56, "Width": 200, "Height": 22},
