    "fraOutlets": {"type": "Frame", "Caption": "PDU outlets", "Left": 15, "Top": 240, "Width": 390, "Height": 75},
    "chkOutlet1": {"type": "CheckBox", "Caption": "1 Router", "Left": 25, "Top": 262, "Width": 90, "Height": 22},
    "chkOutlet2": {"type": "CheckBox", "Caption": "2 Switch", "Left": 120, "Top": 262, "Width": 90, "Height": 22},
    "chkOutlet3": {"type": "CheckBox", "Caption": "3 NVR", "Left": 215, "Top": 262, "Width": 90, "Height": 22},
    "chkOutlet4": {"type": "CheckBox", "Caption": "4 Spare", "Left": 310, "Top": 262, "Width": 90, "Height": 22},
    "lblTraps":   {"type": "Label", "Caption": "Traps (UDP 1162)", "FontBold": true, "Left": 15, "Top": 325, "Width": 200, "Height": 20},
    "lstTraps":   {"type": "ListBox", "Left": 15, "Top": 346, "Width": 630, "Height": 80},
    "snmp1":      {"type": "SNMP", "Host": "${UPS_HOST:-127.0.0.1}", "Port": 1161, "Version": "2c",
                   "Community": "${UPS_COMMUNITY:-public}", "WriteCommunity": "${UPS_WRITE_COMMUNITY:-private}",
                   "PollInterval": 2000, "TrapPort": 1162,
                   "Poll": ["runtime = upsEstimatedMinutesRemaining", "load = upsOutputPercentLoad.1",
                            "source = upsOutputSource", "volts = upsInputVoltage.1", "battV = upsBatteryVoltage /10",
                            "battC = upsBatteryTemperature", "uptime = sysUpTime /100",
                            "port1 = ifOperStatus.1", "port2 = ifOperStatus.2", "port3 = ifOperStatus.3",
                            "out1 = 1.3.6.1.4.1.318.1.1.4.4.2.1.3.1", "out2 = 1.3.6.1.4.1.318.1.1.4.4.2.1.3.2",
                            "out3 = 1.3.6.1.4.1.318.1.1.4.4.2.1.3.3", "out4 = 1.3.6.1.4.1.318.1.1.4.4.2.1.3.4"],
                   "Fill": ["runtime -> gauRuntime.Value", "load -> gauLoad.Value"]}
  }
}
