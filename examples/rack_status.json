    "lblLink":    {"type": "Label", "Caption": "Connecting...", "Left": 354, "Top": 14, "Width": 295, "Height": 20},
    "gauRuntime": {"type": "Gauge", "Title": "Battery runtime", "Units": "min", "Min": 0, "Max": 120,
