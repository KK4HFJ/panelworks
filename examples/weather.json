{
  "name": "Weather",
  "caption": "Weather - Open-Meteo",
  "width": 700,
  "height": 600,
  "code": "weather.py",
  "objects": {
    "lblTitle":  {"type": "Label", "Caption": "Weather", "FontSize": 15, "FontBold": true, "Left": 15, "Top": 10, "Width": 200, "Height": 28},
    "shpLink":   {"type": "Shape", "FillColor": "gray", "Left": 330, "Top": 15, "Width": 16, "Height": 16},
    "lblLink":   {"type": "Label", "Caption": "Asking Open-Meteo...", "Left": 352, "Top": 13, "Width": 250, "Height": 20},
    "cmdRefresh": {"type": "CommandButton", "Caption": "Refresh", "Left": 605, "Top": 10, "Width": 80, "Height": 26},
    "segTemp":   {"type": "SegmentDisplay", "Style": "LCD", "Digits": 4, "Decimals": 1, "Value": "----",
                  "Left": 15, "Top": 50, "Width": 230, "Height": 86},
    "lblUnits":  {"type": "Label", "Caption": "°F", "FontSize": 20, "Left": 250, "Top": 54, "Width": 50, "Height": 34},
    "lblCond":   {"type": "Label", "Caption": "", "FontSize": 13, "FontBold": true, "Left": 15, "Top": 144, "Width": 290, "Height": 24},
    "lblFeels":  {"type": "Label", "Caption": "", "Left": 15, "Top": 170, "Width": 290, "Height": 20},
    "lblToday":  {"type": "Label", "Caption": "", "Left": 15, "Top": 194, "Width": 290, "Height": 20},
    "lblSun":    {"type": "Label", "Caption": "", "Left": 15, "Top": 218, "Width": 290, "Height": 20},
    "gauWind":   {"type": "Gauge", "Title": "Wind", "Units": "mph", "Min": 0, "Max": 60, "Decimals": 0,
                  "Zones": ["30 45 gold", "45 60 red"], "Left": 310, "Top": 48, "Width": 185, "Height": 170},
    "gauHum":    {"type": "Gauge", "Title": "Humidity", "Units": "%", "Min": 0, "Max": 100, "Decimals": 0,
                  "Left": 503, "Top": 48, "Width": 185, "Height": 170},
    "lblWindDir": {"type": "Label", "Caption": "", "Alignment": "Center", "Left": 310, "Top": 220, "Width": 185, "Height": 20},
    "segPress":  {"type": "SegmentDisplay", "Style": "LCD Reverse", "Digits": 5, "Decimals": 2, "Value": "-----",
                  "Left": 520, "Top": 222, "Width": 120, "Height": 34},
    "lblPress":  {"type": "Label", "Caption": "inHg", "Left": 644, "Top": 230, "Width": 50, "Height": 20},
    "chtTemp":   {"type": "Chart", "Title": "Temperature", "Units": "°F", "Window": 21600, "Decimals": 0,
                  "Series": ["Temperature", "Feels like"], "Colors": ["#d62728", "#1f77b4"],
                  "Left": 15, "Top": 262, "Width": 670, "Height": 170},
    "pnlAlarms": {"type": "AlarmPanel", "Title": "Weather alerts", "Left": 15, "Top": 442, "Width": 670, "Height": 145},
    "wx":        {"type": "WebRequest", "PollInterval": 600000,
                  "URL": "${WEATHER_URL:-https://api.open-meteo.com/v1/forecast}?latitude=${WEATHER_LAT:-36.16}&longitude=${WEATHER_LON:--86.78}&current=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m,pressure_msl&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset&temperature_unit=fahrenheit&wind_speed_unit=mph&precipitation_unit=inch&timezone=auto&forecast_days=1",
                  "Poll": ["temp = current.temperature_2m", "feels = current.apparent_temperature",
                           "humidity = current.relative_humidity_2m", "code = current.weather_code",
                           "wind = current.wind_speed_10m", "gust = current.wind_gusts_10m",
                           "wind_dir = current.wind_direction_10m", "rain = current.precipitation",
                           "pressure = current.pressure_msl *0.02953", "updated = current.time",
                           "high = daily.temperature_2m_max[0]", "low = daily.temperature_2m_min[0]",
                           "rain_chance = daily.precipitation_probability_max[0]",
                           "sunrise = daily.sunrise[0]", "sunset = daily.sunset[0]"],
                  "Fill": ["temp -> segTemp.Value", "wind -> gauWind.Value", "humidity -> gauHum.Value",
                           "pressure -> segPress.Value", "temp -> chtTemp.Value", "feels -> chtTemp.Value2"]},
    "alm":       {"type": "Alarms", "Interval": 5000,
                  "Rules": ["Freeze: wx.temp < 33 deadband=1 priority=1 message=Freezing: protect pipes, plants and animals' water",
                            "Gusts: wx.gust > 40 deadband=5 priority=2 message=High wind gusts",
                            "Storm: wx.code >= 95 priority=2 message=Thunderstorm",
                            "NoUpdate: wx.Connected == False delay=1800 priority=3 message=No weather update for 30 minutes"]}
  }
}
