{
  "name": "HvacConsole",
  "caption": "HVAC Console",
  "width": 560,
  "height": 600,
  "code": "hvac_console.py",
  "mqtt": {
    "broker": "${PW_MQTT_HOST:-mqtt.example.com}",
    "port": "${PW_MQTT_PORT:-8883}",
    "tls": true,
    "caFile": "${PW_MQTT_CA}",
    "username": "${PW_MQTT_USER:-panelworks}",
    "password": "${PW_MQTT_PASS}",
    "prefix": "panelworks/hvac"
  },
  "objects": {
    "lblTitle": {
      "type": "Label",
      "Caption": "HVAC",
      "FontBold": true,
      "FontSize": 14,
      "Left": 15,
      "Top": 10,
      "Width": 220,
      "Height": 28,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/state/room",
          "format": "HVAC  {}"
        }
      }
    },
    "shpCyd": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 330,
      "Top": 16,
      "Width": 14,
      "Height": 14,
      "subscribe": {
        "FillColor": {
          "topic": "home/cyd1/status",
          "map": {
            "online": "lime green",
            "offline": "red"
          }
        }
      }
    },
    "lblCyd": {
      "type": "Label",
      "Caption": "cyd1",
      "Left": 348,
      "Top": 12,
      "Width": 60,
      "Height": 22
    },
    "shpRelay": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 420,
      "Top": 16,
      "Width": 14,
      "Height": 14,
      "subscribe": {
        "FillColor": {
          "topic": "home/relay1/status",
          "map": {
            "online": "lime green",
            "offline": "red"
          }
        }
      }
    },
    "lblRelay": {
      "type": "Label",
      "Caption": "relay1",
      "Left": 438,
      "Top": 12,
      "Width": 70,
      "Height": 22
    },
    "lblRoom": {
      "type": "Label",
      "Caption": "--.- °C",
      "FontSize": 30,
      "FontBold": true,
      "Left": 15,
      "Top": 48,
      "Width": 200,
      "Height": 52,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/tele",
          "json": "temp_c",
          "format": "{:.1f} °C"
        }
      }
    },
    "lblRoomF": {
      "type": "Label",
      "Caption": "-- °F",
      "FontSize": 12,
      "Left": 220,
      "Top": 66,
      "Width": 80,
      "Height": 24,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/tele",
          "json": "temp_f",
          "format": "{:.0f} °F"
        }
      }
    },
    "lblRH": {
      "type": "Label",
      "Caption": "Humidity -- %",
      "Left": 15,
      "Top": 106,
      "Width": 140,
      "Height": 20,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/tele",
          "json": "rh",
          "format": "Humidity {:.0f} %"
        }
      }
    },
    "barRH": {
      "type": "ProgressBar",
      "Max": 100,
      "Left": 160,
      "Top": 108,
      "Width": 140,
      "Height": 16,
      "subscribe": {
        "Value": {
          "topic": "home/cyd1/tele",
          "json": "rh"
        }
      }
    },
    "lblSet": {
      "type": "Label",
      "Caption": "Setpoint --",
      "FontSize": 12,
      "Left": 330,
      "Top": 50,
      "Width": 210,
      "Height": 24,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/state/setpoint",
          "format": "Setpoint {:.1f} °C"
        }
      }
    },
    "lblMode": {
      "type": "Label",
      "Caption": "Mode --",
      "FontSize": 12,
      "Left": 330,
      "Top": 76,
      "Width": 210,
      "Height": 24,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/state/mode",
          "format": "Mode: {}"
        }
      }
    },
    "shpLink": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 330,
      "Top": 106,
      "Width": 14,
      "Height": 14,
      "subscribe": {
        "FillColor": {
          "topic": "home/cyd1/tele",
          "json": "hvac.linked",
          "map": {
            "True": "lime green",
            "False": "red"
          }
        }
      }
    },
    "lblLink": {
      "type": "Label",
      "Caption": "Thermostat ↔ relay BLE link",
      "Left": 348,
      "Top": 102,
      "Width": 200,
      "Height": 22
    },
    "shpR1": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 15,
      "Top": 146,
      "Width": 26,
      "Height": 26,
      "subscribe": {
        "FillColor": {
          "topic": "home/relay1/state/1",
          "map": {
            "ON": "lime green",
            "OFF": "gray",
            "*": "orange"
          }
        }
      }
    },
    "lblR1": {
      "type": "Label",
      "Caption": "Channel 1 --",
      "Left": 48,
      "Top": 148,
      "Width": 160,
      "Height": 22,
      "subscribe": {
        "Caption": {
          "topic": "home/relay1/state/1",
          "format": "Channel 1  {}"
        }
      }
    },
    "shpR2": {
      "type": "Shape",
      "FillColor": "gray",
      "Left": 220,
      "Top": 146,
      "Width": 26,
      "Height": 26,
      "subscribe": {
        "FillColor": {
          "topic": "home/relay1/state/2",
          "map": {
            "ON": "lime green",
            "OFF": "gray",
            "*": "orange"
          }
        }
      }
    },
    "lblR2": {
      "type": "Label",
      "Caption": "Channel 2 --",
      "Left": 253,
      "Top": 148,
      "Width": 160,
      "Height": 22,
      "subscribe": {
        "Caption": {
          "topic": "home/relay1/state/2",
          "format": "Channel 2  {}"
        }
      }
    },
    "lblOutside": {
      "type": "Label",
      "Caption": "Outside --",
      "Left": 15,
      "Top": 186,
      "Width": 200,
      "Height": 22,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/weather",
          "json": "temp_c",
          "format": "Outside {:.1f} °C"
        }
      }
    },
    "lblAdvice": {
      "type": "Label",
      "Caption": "Advice --",
      "FontBold": true,
      "Left": 220,
      "Top": 186,
      "Width": 320,
      "Height": 22,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/advice",
          "json": "signal",
          "format": "Advice: {}"
        }
      }
    },
    "lblReason": {
      "type": "Label",
      "Caption": "",
      "FontSize": 9,
      "Left": 15,
      "Top": 210,
      "Width": 530,
      "Height": 20,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/advice",
          "json": "reason"
        }
      }
    },
    "lblCydHealth": {
      "type": "Label",
      "Caption": "cyd1 --",
      "FontSize": 9,
      "Left": 15,
      "Top": 238,
      "Width": 260,
      "Height": 18,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/tele",
          "json": "rssi",
          "format": "cyd1   {:.0f} dBm"
        }
      }
    },
    "lblCydFw": {
      "type": "Label",
      "Caption": "",
      "FontSize": 9,
      "Left": 140,
      "Top": 238,
      "Width": 130,
      "Height": 18,
      "subscribe": {
        "Caption": {
          "topic": "home/cyd1/tele",
          "json": "fw",
          "format": "fw {}"
        }
      }
    },
    "lblRelayHealth": {
      "type": "Label",
      "Caption": "relay1 --",
      "FontSize": 9,
      "Left": 280,
      "Top": 238,
      "Width": 140,
      "Height": 18,
      "subscribe": {
        "Caption": {
          "topic": "home/relay1/tele",
          "json": "rssi",
          "format": "relay1   {:.0f} dBm"
        }
      }
    },
    "lblRelayFw": {
      "type": "Label",
      "Caption": "",
      "FontSize": 9,
      "Left": 420,
      "Top": 238,
      "Width": 120,
      "Height": 18,
      "subscribe": {
        "Caption": {
          "topic": "home/relay1/tele",
          "json": "fw",
          "format": "fw {}"
        }
      }
    },
    "chtTemp": {
      "type": "Chart",
      "Title": "Last hour",
      "Series": [
        "Room °C",
        "Outside °C"
      ],
      "Window": 3600,
      "Decimals": 1,
      "Left": 15,
      "Top": 262,
      "Width": 530,
      "Height": 150,
      "subscribe": {
        "Value": {
          "topic": "home/cyd1/tele",
          "json": "temp_c"
        },
        "Value2": {
          "topic": "home/cyd1/weather",
          "json": "temp_c"
        }
      }
    },
    "lstLog": {
      "type": "ListBox",
      "FontSize": 9,
      "Left": 15,
      "Top": 420,
      "Width": 530,
      "Height": 165
    },
    "mqttLog": {
      "type": "MQTT",
      "Broker": "${PW_MQTT_HOST:-mqtt.example.com}",
      "Port": "${PW_MQTT_PORT:-8883}",
      "TLS": true,
      "CAFile": "${PW_MQTT_CA}",
      "Username": "${PW_MQTT_USER:-panelworks}",
      "Password": "${PW_MQTT_PASS}",
      "Subscriptions": [
        "home/+/status",
        "home/relay1/state/#",
        "home/cyd1/state/#",
        "home/cyd1/advice"
      ]
    }
  }
}
